# Токен бота от @BotFather.
# ВАЖНО: в BotFather выключите privacy mode (/setprivacy → Disable),
# иначе бот не увидит сообщений группы и сводки будут пустыми.
TELEGRAM_BOT_TOKEN=

# Произвольная строка. Ею подписывается вебхук, чтобы в него не стучали чужие.
TELEGRAM_WEBHOOK_SECRET=

# Ключ Anthropic. Без него сайт и бот живут, но сводки отключены.
ANTHROPIC_API_KEY=

# Модель. По умолчанию claude-opus-5 ($5/$25 за 1M токенов).
# Дешевле: claude-sonnet-5 ($2/$10), claude-haiku-4-5 ($1/$5).
ANTHROPIC_MODEL=claude-opus-5

# Публичный адрес приложения и имя бота — для ссылок на лендинге.
CATCHUP_PUBLIC_URL=http://localhost:3000
CATCHUP_BOT_USERNAME=catchup_bot

# Где лежит база.
CATCHUP_DB_PATH=./data/catchup.db

# Сколько суток хранятся чужие сообщения.
CATCHUP_RETENTION_DAYS=14

# Потолки на один запрос к модели — прямой потолок на счёт.
CATCHUP_MAX_CHARS=120000
CATCHUP_MAX_MESSAGES=1200

# Сколько входных токенов в сутки может сжечь один чат.
CATCHUP_DAILY_TOKEN_CAP=400000

# Секрет для /api/cleanup (Bearer-токен).
CATCHUP_CRON_SECRET=
