# ============================================================================
#  restaurant-lead-parser — переменные окружения
#  Скопируй в .env и заполни те ключи, которые у тебя есть.
#  БЕЗ ЕДИНОГО КЛЮЧА проект уже работает: источник OpenStreetMap/Overpass
#  не требует авторизации. Ключи повышают полноту и confidence.
# ============================================================================

# --- Источники заведений ----------------------------------------------------

# OpenStreetMap Overpass API (без ключа). Можно указать своё зеркало.
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Обязателен по правилам OSM: контакт для связи (email или URL проекта).
OSM_USER_AGENT=restaurant-lead-parser/1.0 (contact: you@example.com)

# Яндекс Поиск по организациям (Search API for organizations)
# https://developer.tech.yandex.ru/services/  -> "Поиск по организациям"
YANDEX_PLACES_API_KEY=

# 2ГИС Catalog API — https://dev.2gis.ru/
DGIS_API_KEY=

# --- Поисковые провайдеры (проверка №2) -------------------------------------
# Достаточно ОДНОГО. Без него confidence не поднимется выше ~85.

# Brave Search API — https://brave.com/search/api/ (есть бесплатный тариф)
BRAVE_API_KEY=

# Google Programmable Search (Custom Search JSON API) — 100 запросов/сутки free
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# SerpApi — https://serpapi.com/
SERPAPI_KEY=

# Порядок использования провайдеров, через запятую: brave,google_cse,serpapi
SEARCH_PROVIDERS=brave,google_cse,serpapi

# --- Соцсети (проверка №3) --------------------------------------------------
# VK API service token: https://dev.vk.com/ -> приложение -> сервисный ключ
VK_SERVICE_TOKEN=
VK_API_VERSION=5.199

# --- Прочее -----------------------------------------------------------------
DB_PATH=data/leads.sqlite3
LOG_LEVEL=INFO
HTTP_TIMEOUT=20
