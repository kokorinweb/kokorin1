# ── ИИ-помощник по заказу ────────────────────────────────────────
# Ключ: https://console.anthropic.com/settings/keys
# Без ключа сайт работает полностью, а помощник собирает тот же бриф
# по заранее заданным вопросам — демо можно показывать без настройки.
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно. По умолчанию claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
