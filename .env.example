# ── ИИ-консультант (сайт + Telegram) ─────────────────────────────
# Ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Необязательно. По умолчанию claude-sonnet-5 — быстрый и дешёвый для чата поддержки.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Telegram-бот ─────────────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Чат, куда падают новые заказы с сайта (личка менеджера или группа).
# Узнать id: напишите боту и откройте https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ORDERS_CHAT_ID=-1001234567890
# Придумайте любую строку. Проверяется в /api/telegram, чтобы вебхук не дёргали посторонние.
TELEGRAM_WEBHOOK_SECRET=

# ── База заказов (CRM) ───────────────────────────────────────────
# Пусто — локальный режим: Postgres в WASM (PGlite) с файлами в .data/pgdata.
# Ноль установки, но каталог держит один процесс: dev-сервер и сид одновременно
# работать не будут, и на serverless (Vercel) это не поедет.
# Для прода — строка подключения к настоящему Postgres, например Neon/Supabase:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# ── Админка ──────────────────────────────────────────────────────
# Пароль смены. Пока не задан, /admin закрыт целиком — и это правильно:
# в админке телефоны и адреса гостей.
ADMIN_PASSWORD=
# Необязательно. Секрет подписи cookie сессии; по умолчанию берётся ADMIN_PASSWORD
# (сменили пароль — все сессии разлогинились).
ADMIN_SESSION_SECRET=

# ── Сайт ─────────────────────────────────────────────────────────
# Публичный адрес: на него бот ведёт кнопкой «Заказать на сайте».
NEXT_PUBLIC_SITE_URL=http://localhost:3000
